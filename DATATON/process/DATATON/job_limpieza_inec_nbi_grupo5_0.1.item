        <mapperTableEntries name="v_no_extrema_valido" expression="Var.v_txt_no_extrema.matches(&quot;[0-9]+(\\.0+)?&quot;)" type="id_Boolean"/>
        <mapperTableEntries name="v_extrema_valido" expression="Var.v_txt_extrema.matches(&quot;[0-9]+(\\.0+)?&quot;) " type="id_Boolean"/>
        <mapperTableEntries name="v_totales_consistentes" expression="Var.v_total_valido &amp;&amp; Var.v_no_extrema_valido &amp;&amp; Var.v_extrema_valido &amp;&amp; Math.abs( Double.parseDouble(Var.v_txt_no_extrema) + Double.parseDouble(Var.v_txt_extrema) - Double.parseDouble(Var.v_txt_total) ) &lt; 0.000001 " type="id_Boolean"/>
        <mapperTableEntries name="v_nbi_9_1_valido" expression="Var.v_provincia_valida &amp;&amp; Var.v_canton_valido &amp;&amp; Var.v_area_valida &amp;&amp; Var.v_totales_consistentes" type="id_Boolean"/>
