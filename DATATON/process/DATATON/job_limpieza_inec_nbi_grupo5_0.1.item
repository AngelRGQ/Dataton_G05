        <mapperTableEntries name="v_pobres_validos" expression="row1.hogares_pobres != null &amp;&amp; row1.hogares_pobres >= 0" type="id_Boolean"/>
        <mapperTableEntries name="v_no_pobres_validos" expression="row1.hogares_no_pobres != null &amp;&amp; row1.hogares_no_pobres >= 0" type="id_Boolean"/>
        <mapperTableEntries name="v_totales_consistentes" expression="Var.v_total_valido &amp;&amp; Var.v_pobres_validos &amp;&amp; Var.v_no_pobres_validos &amp;&amp; ((long) row1.hogares_pobres + (long) row1.hogares_no_pobres == (long) row1.total_hogares)" type="id_Boolean"/>
        <mapperTableEntries name="v_nbi_valido" expression="Var.v_provincia_valida &amp;&amp; Var.v_canton_valido &amp;&amp; Var.v_area_informada &amp;&amp; Var.v_totales_consistentes" type="id_Boolean"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="out_nbi_8_1_valido_g5" expressionFilter="Var.v_nbi_valido" activateExpressionFilter="true">
