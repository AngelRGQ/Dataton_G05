        <mapperTableEntries name="v_provincia_valida" expression="row6.provincia != null &amp;&amp; !row6.provincia.trim().isEmpty()" type="id_Boolean"/>
        <mapperTableEntries name="v_canton_valido" expression="row6.canton != null &amp;&amp; !row6.canton.trim().isEmpty()" type="id_Boolean"/>
