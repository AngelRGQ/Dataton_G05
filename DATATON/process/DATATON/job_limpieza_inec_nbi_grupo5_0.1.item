        <mapperTableEntries name="pct_pobreza_extrema_nbi" expression="!Var.v_nbi_9_1_valido || Double.parseDouble(Var.v_txt_total) == 0 ? (Double) null : Double.valueOf( 100.0 * Double.parseDouble(Var.v_txt_extrema) / Double.parseDouble(Var.v_txt_total) )" type="id_Double" nullable="true"/>
        <mapperTableEntries name="pct_no_pobreza_extrema_nbi" expression="!Var.v_nbi_9_1_valido || Double.parseDouble(Var.v_txt_total) == 0 ? (Double) null : Double.valueOf( 100.0 * Double.parseDouble(Var.v_txt_no_extrema) / Double.parseDouble(Var.v_txt_total) )" type="id_Double" nullable="true"/>
        <mapperTableEntries name="nivel_geografico" expression="row6.provincia.trim().equalsIgnoreCase(&quot;Total Nacional&quot;) || row6.canton.trim().equalsIgnoreCase(&quot;Nacional&quot;) ? &quot;NACIONAL&quot; : row6.canton.trim().toLowerCase().startsWith(&quot;total &quot;) ? &quot;PROVINCIAL&quot; : &quot;CANTONAL&quot;" type="id_String" nullable="true"/>
