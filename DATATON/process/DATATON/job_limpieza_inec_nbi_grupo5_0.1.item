        <mapperTableEntries name="hogares_no_pobres" expression="row1.hogares_no_pobres " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="hogares_pobres" expression="row1.hogares_pobres " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="load_ts" expression="row1.load_ts " type="id_Date" nullable="true"/>
        <mapperTableEntries name="load_source" expression="row1.load_source " type="id_String" nullable="true"/>
        <mapperTableEntries name="pct_pobreza_nbi" expression="row1.total_hogares == null || row1.total_hogares &lt;= 0 || row1.hogares_pobres == null ? (Double) null : Double.valueOf( 100.0 * row1.hogares_pobres / row1.total_hogares ) " type="id_Double" nullable="true"/>
        <mapperTableEntries name="pct_no_pobreza_nbi" expression="row1.total_hogares == null || row1.total_hogares &lt;= 0 || row1.hogares_no_pobres == null ? (Double) null : Double.valueOf( 100.0 * row1.hogares_no_pobres / row1.total_hogares )" type="id_Double" nullable="true"/>
