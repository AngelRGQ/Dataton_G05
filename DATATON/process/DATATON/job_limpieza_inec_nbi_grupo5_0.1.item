        <mapperTableEntries name="load_ts" expression="row2.load_ts " type="id_Date" nullable="true"/>
        <mapperTableEntries name="load_source" expression="row2.load_source " type="id_String" nullable="true"/>
        <mapperTableEntries name="pct_pobreza_nbi" expression="row2.total_hogares == null || row2.total_hogares &lt;= 0 || row2.hogares_pobres == null ? (Double) null : Double.valueOf( 100.0 * row2.hogares_pobres.doubleValue() / row2.total_hogares.doubleValue() )" type="id_Double" nullable="true"/>
        <mapperTableEntries name="pct_no_pobreza_nbi" expression="row2.total_hogares == null || row2.total_hogares &lt;= 0 || row2.hogares_no_pobres == null ? (Double) null : Double.valueOf( 100.0 * row2.hogares_no_pobres.doubleValue() / row2.total_hogares.doubleValue() )" type="id_Double" nullable="true"/>
        <mapperTableEntries name="nivel_geografico" expression="row2.provincia.trim().equalsIgnoreCase(&quot;Total Nacional&quot;) || row2.canton.trim().equalsIgnoreCase(&quot;Nacional&quot;) ? &quot;NACIONAL&quot; : row2.canton.trim().toLowerCase().startsWith(&quot;total &quot;) ? &quot;PROVINCIAL&quot; : row2.parroquia.trim().toLowerCase().startsWith(&quot;total &quot;) ? &quot;CANTONAL&quot; : &quot;PARROQUIAL&quot;" type="id_String" nullable="true"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="out_nbi_8_2_rechazado_g5" expressionFilter="!Var.v_nbi_parroquia_valido" activateExpressionFilter="true">
