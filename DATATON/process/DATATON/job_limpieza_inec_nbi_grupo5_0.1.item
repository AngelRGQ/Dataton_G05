        <mapperTableEntries name="motivo_rechazo" expression="!Var.v_provincia_valida ? &quot;DQ-NBI38: Provincia vacia&quot; : !Var.v_canton_valido ? &quot;DQ-NBI38: Canton vacio&quot; : !Var.v_area_valida ? &quot;DQ-NBI38: Area vacia&quot; : !Var.v_total_valido ? &quot;DQ-NBI39: Total hogares invalido&quot; : !Var.v_no_extrema_valido ? &quot;DQ-NBI40: Hogares no extrema invalidos&quot; : !Var.v_extrema_valido ? &quot;DQ-NBI41: Hogares extrema invalidos&quot; : !Var.v_totales_consistentes ? &quot;DQ-NBI42: Totales inconsistentes&quot; : &quot;SIN_ERROR&quot;" type="id_String" nullable="true"/>
