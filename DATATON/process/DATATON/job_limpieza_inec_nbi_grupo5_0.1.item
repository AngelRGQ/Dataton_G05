        <mapperTableEntries name="hogares_no_pobres" expression="row2.hogares_no_pobres " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="hogares_pobres" expression="row2.hogares_pobres " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="load_ts" expression="row2.load_ts " type="id_Date" nullable="true"/>
        <mapperTableEntries name="load_source" expression="row2.load_source " type="id_String" nullable="true"/>
        <mapperTableEntries name="motivo_rechazo" expression="!Var.v_provincia_valida ? &quot;DQ-NBI08: Provincia vacia&quot; : !Var.v_canton_valido ? &quot;DQ-NBI09: Canton vacio&quot; : !Var.v_parroquia_valida ? &quot;DQ-NBI10: Parroquia vacia&quot; : !Var.v_area_valida ? &quot;DQ-NBI11: Area vacia&quot; : !Var.v_total_valido ? &quot;DQ-NBI12: Total hogares invalido&quot; : !Var.v_pobres_validos ? &quot;DQ-NBI13: Hogares pobres invalidos&quot; : !Var.v_no_pobres_validos ? &quot;DQ-NBI14: Hogares no pobres invalidos&quot; : !Var.v_totales_consistentes ? &quot;DQ-NBI15: Totales inconsistentes&quot; : &quot;SIN_ERROR&quot;" type="id_String" nullable="true"/>
      </outputTables>
