        <mapperTableEntries name="v_canton_valido" expression="row2.canton != null &amp;&amp; !row2.canton.trim().isEmpty()" type="id_Boolean"/>
        <mapperTableEntries name="v_parroquia_valida" expression="row2.parroquia != null &amp;&amp; !row2.parroquia.trim().isEmpty()" type="id_Boolean"/>
        <mapperTableEntries name="v_area_valida" expression="row2.area != null &amp;&amp; !row2.area.trim().isEmpty()" type="id_Boolean"/>
        <mapperTableEntries name="v_total_valido" expression="row2.total_hogares != null &amp;&amp; row2.total_hogares >= 0" type="id_Boolean"/>
        <mapperTableEntries name="v_pobres_validos" expression="row2.hogares_pobres != null &amp;&amp; row2.hogares_pobres >= 0" type="id_Boolean"/>
        <mapperTableEntries name="v_no_pobres_validos" expression="row2.hogares_no_pobres != null &amp;&amp; row2.hogares_no_pobres >= 0" type="id_Boolean"/>
        <mapperTableEntries name="v_totales_consistentes" expression="Var.v_total_valido &amp;&amp; Var.v_pobres_validos &amp;&amp; Var.v_no_pobres_validos &amp;&amp; Math.abs( row2.hogares_pobres.doubleValue() + row2.hogares_no_pobres.doubleValue() - row2.total_hogares.doubleValue() ) &lt; 0.000001 " type="id_Boolean"/>
        <mapperTableEntries name="v_nbi_parroquia_valido" expression="Var.v_provincia_valida &amp;&amp; Var.v_canton_valido &amp;&amp; Var.v_parroquia_valida &amp;&amp; Var.v_area_valida &amp;&amp; Var.v_totales_consistentes" type="id_Boolean"/>
      </varTables>
