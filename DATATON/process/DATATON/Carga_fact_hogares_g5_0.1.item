    <elementParameter field="CHECK" name="END_OF_FLOW" value="false" show="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tMysqlInput" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Talend\8.0.1\studio\configuration\lib\java" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="MYSQL_8"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="context.DB_HOST"/>
    <elementParameter field="TEXT" name="PORT" value="context.DB_PORT"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.DB_NAME"/>
    <elementParameter field="TEXT" name="TYPE" value="MySQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="context.DB_USER"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.DB_PASSWORD"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;DSADEV.stg_CPV_2022_Hogar_Canton_g5&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;&#xD;&#xA;SELECT&#xD;&#xA;    c.id_hog AS id_hogar,&#xD;&#xA;    c.id_viv AS id_vivienda,&#xD;&#xA;    c.id_geografia,&#xD;&#xA;    c.fecha,&#xD;&#xA;    i.id_indicador,&#xD;&#xA;&#xD;&#xA;    CASE i.id_indicador&#xD;&#xA;        WHEN 'I01' THEN&#xD;&#xA;            CASE&#xD;&#xA;                WHEN c.n_personas = 0 THEN NULL&#xD;&#xA;                WHEN c.max_i01 = 1 THEN 1&#xD;&#xA;                WHEN c.n_5_17 = 0&#xD;&#xA;                     AND c.n_edad_null = 0 THEN 0&#xD;&#xA;                WHEN c.nulos_i01 > 0&#xD;&#xA;                     OR c.n_edad_null > 0 THEN NULL&#xD;&#xA;                ELSE 0&#xD;&#xA;            END&#xD;&#xA;&#xD;&#xA;        WHEN 'I02' THEN&#xD;&#xA;            CASE&#xD;&#xA;                WHEN c.n_personas = 0 THEN NULL&#xD;&#xA;                WHEN c.max_i02 = 1 THEN 1&#xD;&#xA;                WHEN c.n_18_64 = 0&#xD;&#xA;                     AND c.n_edad_null = 0 THEN 0&#xD;&#xA;                WHEN c.nulos_i02 > 0&#xD;&#xA;                     OR c.n_edad_null > 0 THEN NULL&#xD;&#xA;                ELSE 0&#xD;&#xA;            END&#xD;&#xA;&#xD;&#xA;        WHEN 'I03' THEN c.I03&#xD;&#xA;        WHEN 'I04' THEN c.I04&#xD;&#xA;        WHEN 'I05' THEN c.I05&#xD;&#xA;        WHEN 'I06' THEN c.I06&#xD;&#xA;        WHEN 'I07' THEN c.I07&#xD;&#xA;        WHEN 'I08' THEN c.I08&#xD;&#xA;        WHEN 'I09' THEN c.I09&#xD;&#xA;    END AS es_privacion,&#xD;&#xA;&#xD;&#xA;    'CPV' AS fuente_datos,&#xD;&#xA;    'Carga_fact_hogares_g5' AS load_source&#xD;&#xA;&#xD;&#xA;FROM (&#xD;&#xA;    SELECT&#xD;&#xA;        h.id_hog,&#xD;&#xA;        h.id_viv,&#xD;&#xA;        g.id_geografia,&#xD;&#xA;        t.fecha,&#xD;&#xA;&#xD;&#xA;        COUNT(p.id_hog) AS n_personas,&#xD;&#xA;&#xD;&#xA;        SUM(CASE&#xD;&#xA;            WHEN p.p03 BETWEEN 5 AND 17&#xD;&#xA;            THEN 1 ELSE 0&#xD;&#xA;        END) AS n_5_17,&#xD;&#xA;&#xD;&#xA;        SUM(CASE&#xD;&#xA;            WHEN p.p03 BETWEEN 18 AND 64&#xD;&#xA;            THEN 1 ELSE 0&#xD;&#xA;        END) AS n_18_64,&#xD;&#xA;&#xD;&#xA;        SUM(CASE&#xD;&#xA;            WHEN p.id_hog IS NOT NULL&#xD;&#xA;                 AND p.p03 IS NULL&#xD;&#xA;            THEN 1 ELSE 0&#xD;&#xA;        END) AS n_edad_null,&#xD;&#xA;&#xD;&#xA;        MAX(CASE&#xD;&#xA;            WHEN p.p03 BETWEEN 5 AND 17&#xD;&#xA;            THEN p.privacion_inasistencia&#xD;&#xA;        END) AS max_i01,&#xD;&#xA;&#xD;&#xA;        MAX(CASE&#xD;&#xA;            WHEN p.p03 BETWEEN 18 AND 64&#xD;&#xA;            THEN p.privacion_logro_incompleto&#xD;&#xA;        END) AS max_i02,&#xD;&#xA;&#xD;&#xA;        SUM(CASE&#xD;&#xA;            WHEN p.p03 BETWEEN 5 AND 17&#xD;&#xA;                 AND p.privacion_inasistencia IS NULL&#xD;&#xA;            THEN 1 ELSE 0&#xD;&#xA;        END) AS nulos_i01,&#xD;&#xA;&#xD;&#xA;        SUM(CASE&#xD;&#xA;            WHEN p.p03 BETWEEN 18 AND 64&#xD;&#xA;                 AND p.privacion_logro_incompleto IS NULL&#xD;&#xA;            THEN 1 ELSE 0&#xD;&#xA;        END) AS nulos_i02,&#xD;&#xA;&#xD;&#xA;        MAX(v.privacion_agua) AS I03,&#xD;&#xA;        MAX(v.privacion_saneamiento) AS I04,&#xD;&#xA;        MAX(h.privacion_hacinamiento) AS I05,&#xD;&#xA;        MAX(v.privacion_deficit_habitacional) AS I06,&#xD;&#xA;        MAX(v.privacion_basura) AS I07,&#xD;&#xA;        MAX(v.privacion_electricidad) AS I08,&#xD;&#xA;        MAX(h.privacion_lena_carbon) AS I09&#xD;&#xA;&#xD;&#xA;    FROM (&#xD;&#xA;        SELECT&#xD;&#xA;            id_hog,&#xD;&#xA;            id_viv,&#xD;&#xA;            canton,&#xD;&#xA;            privacion_hacinamiento,&#xD;&#xA;            privacion_lena_carbon&#xD;&#xA;        FROM DSADEV.stg_CPV_2022_Hogar_Canton_g5&#xD;&#xA;    ) h&#xD;&#xA;&#xD;&#xA;    LEFT JOIN DSADEV.stg_CPV_2022_Poblacion_Canton_g5 p&#xD;&#xA;        ON h.id_hog = p.id_hog&#xD;&#xA;&#xD;&#xA;    LEFT JOIN DSADEV.stg_CPV_2022_Vivienda_Canton_g5 v&#xD;&#xA;        ON h.id_viv = v.id_viv&#xD;&#xA;&#xD;&#xA;    LEFT JOIN DWHDEV.dim_geografia_g5 g&#xD;&#xA;        ON h.canton = g.cod_canton&#xD;&#xA;&#xD;&#xA;    LEFT JOIN DWHDEV.dim_tiempo_g5 t&#xD;&#xA;        ON t.fecha = '2022-01-01'&#xD;&#xA;&#xD;&#xA;    GROUP BY&#xD;&#xA;        h.id_hog,&#xD;&#xA;        h.id_viv,&#xD;&#xA;        g.id_geografia,&#xD;&#xA;        t.fecha&#xD;&#xA;) c&#xD;&#xA;&#xD;&#xA;CROSS JOIN DWHDEV.dim_indicadores_g5 i&#xD;&#xA;&#xD;&#xA;WHERE i.id_indicador IN (&#xD;&#xA;    'I01', 'I02', 'I03',&#xD;&#xA;    'I04', 'I05', 'I06',&#xD;&#xA;    'I07', 'I08', 'I09'&#xD;&#xA;)&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" value="mysql_id" show="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;noDatetimeStringSync=true&quot;"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;ISO-8859-15&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
    <elementParameter field="CHECK" name="ENABLE_STREAM" value="true"/>
    <elementParameter field="CHECK" name="TRIM_ALL_COLUMN" value="false"/>
    <elementParameter field="TABLE" name="TRIM_COLUMN">
      <elementValue elementRef="SCHEMA_COLUMN" value="id_hog" id="0"/>
      <elementValue elementRef="TRIM" value="false" id="1"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="id_viv" id="2"/>
      <elementValue elementRef="TRIM" value="false" id="3"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="id_geografia" id="4"/>
      <elementValue elementRef="TRIM" value="false" id="5"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="fecha" id="6"/>
      <elementValue elementRef="TRIM" value="false" id="7"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="id_indicador" id="8"/>
      <elementValue elementRef="TRIM" value="false" id="9"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="es_privacion" id="10"/>
      <elementValue elementRef="TRIM" value="false" id="11"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="fuente_datos" id="12"/>
      <elementValue elementRef="TRIM" value="false" id="13"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="load_source" id="14"/>
      <elementValue elementRef="TRIM" value="false" id="15"/>
    </elementParameter>
    <elementParameter field="TEXT" name="LABEL" value="tDBInput_Consolidado"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
