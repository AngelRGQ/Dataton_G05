  <node componentName="tMysqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="80" posY="280">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBInput_2" show="false"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tMysqlInput" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.102 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Databases/DB Specifics/MySQL" show="false"/>
    <elementParameter field="CHECK" name="START" value="true" show="false"/>
    <elementParameter field="CHECK" name="STARTABLE" value="true" show="false"/>
