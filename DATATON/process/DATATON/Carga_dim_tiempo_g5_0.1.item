    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&#xD;&#xA;&quot;CREATE TABLE IF NOT EXISTS DWHDEV.dim_tiempo_g5 (&quot; +&#xD;&#xA;&quot;    fecha DATE NOT NULL, &quot; +&#xD;&#xA;&quot;    anio INT NOT NULL, &quot; +&#xD;&#xA;&quot;    trimestre TINYINT NOT NULL, &quot; +&#xD;&#xA;&quot;    mes TINYINT NOT NULL, &quot; +&#xD;&#xA;&quot;    dia TINYINT NOT NULL, &quot; +&#xD;&#xA;&quot;    dia_semana TINYINT NOT NULL, &quot; +&#xD;&#xA;&quot;    es_fin_semana TINYINT NOT NULL, &quot; +&#xD;&#xA;&quot;    etl TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, &quot; +&#xD;&#xA;&quot;    PRIMARY KEY (fecha) &quot; +&#xD;&#xA;&quot;); &quot; +&#xD;&#xA;&#xD;&#xA;&quot;INSERT IGNORE INTO DWHDEV.dim_tiempo_g5 &quot; +&#xD;&#xA;&quot;(fecha, anio, trimestre, mes, dia, dia_semana, es_fin_semana, etl) &quot; +&#xD;&#xA;&#xD;&#xA;&quot;SELECT &quot; +&#xD;&#xA;&quot;    d.fecha, &quot; +&#xD;&#xA;&quot;    YEAR(d.fecha), &quot; +&#xD;&#xA;&quot;    QUARTER(d.fecha), &quot; +&#xD;&#xA;&quot;    MONTH(d.fecha), &quot; +&#xD;&#xA;&quot;    DAYOFMONTH(d.fecha), &quot; +&#xD;&#xA;&quot;    DAYOFWEEK(d.fecha), &quot; +&#xD;&#xA;&quot;    CASE WHEN DAYOFWEEK(d.fecha) IN (1, 7) &quot; +&#xD;&#xA;&quot;         THEN 1 ELSE 0 END, &quot; +&#xD;&#xA;&quot;    NOW() &quot; +&#xD;&#xA;&#xD;&#xA;&quot;FROM (&quot; +&#xD;&#xA;&quot;    SELECT DATE_ADD(&quot; +&#xD;&#xA;&quot;        '2020-01-01', &quot; +&#xD;&#xA;&quot;        INTERVAL (a.n + b.n * 10 + c.n * 100 + e.n * 1000) DAY&quot; +&#xD;&#xA;&quot;    ) AS fecha &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    FROM (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 9) a &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    CROSS JOIN (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 9) b &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    CROSS JOIN (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 9) c &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    CROSS JOIN (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 &quot; +&#xD;&#xA;&quot;          UNION ALL SELECT 9) e &quot; +&#xD;&#xA;&quot;) d &quot; +&#xD;&#xA;&#xD;&#xA;&quot;WHERE d.fecha BETWEEN '2020-01-01' AND '2025-12-31';&quot;&#xD;&#xA;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
