    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="v_prov_ok" expression="row1.dpa_provin != null &amp;&amp; row1.dpa_provin.matches(&quot;\\d{2}&quot;)" type="id_Boolean"/>
        <mapperTableEntries name="v_canton_ok" expression="row1.dpa_canton != null &amp;&amp; row1.dpa_canton.matches(&quot;\\d{4}&quot;)" type="id_Boolean"/>
        <mapperTableEntries name="v_parroq_ok" expression="row1.dpa_parroq != null &amp;&amp; row1.dpa_parroq.matches(&quot;\\d{6}&quot;)" type="id_Boolean"/>
        <mapperTableEntries name="v_prov_canton_ok" expression="Var.v_prov_ok &amp;&amp; Var.v_canton_ok &amp;&amp; row1.dpa_canton.substring(0,2).equals(row1.dpa_provin)" type="id_Boolean"/>
        <mapperTableEntries name="v_canton_parroq_ok" expression="Var.v_canton_ok &amp;&amp; Var.v_parroq_ok &amp;&amp; row1.dpa_parroq.substring(0,4).equals(row1.dpa_canton)" type="id_Boolean"/>
        <mapperTableEntries name="v_nombres_ok" expression="row1.dpa_despro != null &amp;&amp; !row1.dpa_despro.trim().isEmpty() &amp;&amp; row1.dpa_descan != null &amp;&amp; !row1.dpa_descan.trim().isEmpty() &amp;&amp; row1.dpa_despar != null &amp;&amp; !row1.dpa_despar.trim().isEmpty()" type="id_Boolean"/>
        <mapperTableEntries name="v_es_valido" expression="Var.v_prov_ok &amp;&amp; Var.v_canton_ok &amp;&amp; Var.v_parroq_ok &amp;&amp; Var.v_prov_canton_ok &amp;&amp; Var.v_canton_parroq_ok &amp;&amp; Var.v_nombres_ok" type="id_Boolean"/>
        <mapperTableEntries name="v_motivo" expression="(!Var.v_prov_ok ? &quot;PROVINCIA_FORMATO;&quot; : &quot;&quot;) + (!Var.v_canton_ok ? &quot;CANTON_FORMATO;&quot; : &quot;&quot;) + (!Var.v_parroq_ok ? &quot;PARROQUIA_FORMATO;&quot; : &quot;&quot;) + (!Var.v_prov_canton_ok ? &quot;PROV_CANTON_INCONSISTENTE;&quot; : &quot;&quot;) + (!Var.v_canton_parroq_ok ? &quot;CANTON_PARROQ_INCONSISTENTE;&quot; : &quot;&quot;) + (!Var.v_nombres_ok ? &quot;NOMBRE_NULO_O_VACIO;&quot; : &quot;&quot;)" type="id_String"/>
      </varTables>
