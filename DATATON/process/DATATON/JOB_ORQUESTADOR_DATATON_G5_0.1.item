    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;output_row.total_geografia = input_row.total_geografia;&#xD;&#xA;output_row.cantones_unicos = input_row.cantones_unicos;&#xD;&#xA;output_row.total_indicadores = input_row.total_indicadores;&#xD;&#xA;output_row.total_tiempo = input_row.total_tiempo;&#xD;&#xA;output_row.total_fact = input_row.total_fact;&#xD;&#xA;&#xD;&#xA;// Validacion individual de dimensiones&#xD;&#xA;boolean geografiaOK =&#xD;&#xA;    input_row.total_geografia != null &amp;&amp;&#xD;&#xA;    input_row.total_geografia == 221L &amp;&amp;&#xD;&#xA;    input_row.cantones_unicos != null &amp;&amp;&#xD;&#xA;    input_row.cantones_unicos == 221L;&#xD;&#xA;&#xD;&#xA;boolean tiempoOK =&#xD;&#xA;    input_row.total_tiempo != null &amp;&amp;&#xD;&#xA;    input_row.total_tiempo == 2192L;&#xD;&#xA;&#xD;&#xA;boolean indicadoresOK =&#xD;&#xA;    input_row.total_indicadores != null &amp;&amp;&#xD;&#xA;    input_row.total_indicadores == 9L;&#xD;&#xA;&#xD;&#xA;// Validacion preliminar de la fact&#xD;&#xA;boolean factConteoOK =&#xD;&#xA;    input_row.total_fact != null &amp;&amp;&#xD;&#xA;    input_row.total_fact == 46741932L;&#xD;&#xA;&#xD;&#xA;// Guardar decisiones para el orquestador&#xD;&#xA;globalMap.put(&quot;GEOGRAFIA_OK&quot;, geografiaOK);&#xD;&#xA;globalMap.put(&quot;TIEMPO_OK&quot;, tiempoOK);&#xD;&#xA;globalMap.put(&quot;INDICADORES_OK&quot;, indicadoresOK);&#xD;&#xA;globalMap.put(&quot;FACT_COMPLETA_CONTEO&quot;, factConteoOK);&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;DIMENSIONES_OK&quot;,&#xD;&#xA;    geografiaOK &amp;&amp; tiempoOK &amp;&amp; indicadoresOK);&#xD;&#xA;&#xD;&#xA;// Mostrar estado individual&#xD;&#xA;System.out.println(&quot;===== CONTROL DE CARGAS G5 =====&quot;);&#xD;&#xA;&#xD;&#xA;System.out.println(geografiaOK&#xD;&#xA;    ? &quot;[SKIP] Geografia: carga existente&quot;&#xD;&#xA;    : &quot;[REVISION] Geografia: conteo incorrecto&quot;);&#xD;&#xA;&#xD;&#xA;System.out.println(tiempoOK&#xD;&#xA;    ? &quot;[SKIP] Tiempo: calendario existente&quot;&#xD;&#xA;    : &quot;[REVISION] Tiempo: conteo incorrecto&quot;);&#xD;&#xA;&#xD;&#xA;System.out.println(indicadoresOK&#xD;&#xA;    ? &quot;[SKIP] Indicadores: carga existente&quot;&#xD;&#xA;    : &quot;[REVISION] Indicadores: conteo incorrecto&quot;);&#xD;&#xA;&#xD;&#xA;System.out.println(factConteoOK&#xD;&#xA;    ? &quot;[SKIP] Fact: conteo esperado alcanzado&quot;&#xD;&#xA;    : &quot;[REVISION] Fact: conteo incorrecto&quot;);&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;===============================&quot;);&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;TOTAL_GEOGRAFIA&quot;, input_row.total_geografia);&#xD;&#xA;globalMap.put(&quot;TOTAL_TIEMPO&quot;, input_row.total_tiempo);&#xD;&#xA;globalMap.put(&quot;TOTAL_INDICADORES&quot;, input_row.total_indicadores);&#xD;&#xA;globalMap.put(&quot;TOTAL_FACT&quot;, input_row.total_fact);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="tJavaRow_Validar_Estado"/>
