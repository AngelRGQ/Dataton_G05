    <elementParameter field="MEMO_SQL" name="QUERY" value="&#xD;&#xA;&quot;SELECT &quot; +&#xD;&#xA;&quot; (SELECT COUNT(*) FROM DWHDEV.dim_geografia_g5) AS total_geografia, &quot; +&#xD;&#xA;&quot; (SELECT COUNT(DISTINCT cod_canton) FROM DWHDEV.dim_geografia_g5) AS cantones_unicos, &quot; +&#xD;&#xA;&quot; (SELECT COUNT(*) FROM DWHDEV.dim_indicadores_g5) AS total_indicadores, &quot; +&#xD;&#xA;&quot; (SELECT COUNT(*) FROM DWHDEV.dim_tiempo_g5) AS total_tiempo, &quot; +&#xD;&#xA;&quot; (SELECT COUNT(*) FROM DWHDEV.fact_hogares_g5 WHERE fuente_datos = 'CPV') AS total_fact&quot;&#xD;&#xA;"/>
