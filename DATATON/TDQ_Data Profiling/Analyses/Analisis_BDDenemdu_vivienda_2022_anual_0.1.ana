      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_xj2zwtoFEfG1mLTNfSJ-KA" count="106362" computed="true" distinctValueCount="5949">
        <parameters xmi:id="_xj2zw9oFEfG1mLTNfSJ-KA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/BDDenemdu_vivienda_2022_anual_0.1.item#_C8VQYdilEfGlBbYMxLBL7w"/>
