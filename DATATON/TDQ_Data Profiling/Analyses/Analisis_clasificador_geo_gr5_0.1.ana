      <indicators xsi:type="dataquality.indicators:RowCountIndicator" xmi:id="_dj2kUdoMEfGjVb1XdXSgUA" count="1042" computed="true">
        <parameters xmi:id="_dj2kUtoMEfGjVb1XdXSgUA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/CODIFICACIÓN_2022_0.1.item#_M3_V49oKEfGjVb1XdXSgUA"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Row_Count_0.1.definition#_ccFOkBF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_d3t7gNoMEfGjVb1XdXSgUA" name="Row Count" label="Row Count">
          <taggedValue xmi:id="_d3t7gdoMEfGjVb1XdXSgUA" tag="Description" value="counts the number of rows"/>
          <taggedValue xmi:id="_d3t7gtoMEfGjVb1XdXSgUA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_d3t7g9oMEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_dj2kU9oMEfGjVb1XdXSgUA" count="1042" computed="true">
