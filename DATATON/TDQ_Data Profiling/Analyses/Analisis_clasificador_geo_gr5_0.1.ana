        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/CODIFICACIÓN_2022_0.1.item#_M3_V4doKEfGjVb1XdXSgUA"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Null_Count_0.1.definition#_GrAeADh9Ed2XmO7pl5Yuyg"/>
        <builtInIndicatorDefinition xmi:id="_d0dzMNoMEfGjVb1XdXSgUA" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_d0dzMdoMEfGjVb1XdXSgUA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_d0dzMtoMEfGjVb1XdXSgUA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_d0dzM9oMEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
