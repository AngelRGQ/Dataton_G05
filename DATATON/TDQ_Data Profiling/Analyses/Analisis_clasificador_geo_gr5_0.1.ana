  <dataquality.analysis:Analysis xmi:id="_5eFQANoLEfGjVb1XdXSgUA" name="Analisis_clasificador_geo_gr5" creationDate="2026-11-06T13:00:06.105-0500" defaultContext="Default">
    <clientDependency href="../../metadata/fileDelimited/lago_de_datos_grupo5/CODIFICACIÓN_2022_0.1.item#_dj19QNoMEfGjVb1XdXSgUA"/>
