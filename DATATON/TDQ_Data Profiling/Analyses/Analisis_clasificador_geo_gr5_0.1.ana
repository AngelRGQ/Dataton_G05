    <taggedValue xmi:id="_5eHFMdoLEfGjVb1XdXSgUA" tag="Author" value="jermin.vasquez@trial.8mbr1j3q00lfq88.us.qlikcloud.com"/>
    <taggedValue xmi:id="_5eHFMtoLEfGjVb1XdXSgUA" tag="Purpose" value="Evaluar la calidad de los datos del Clasificador Geográfico 2022 del INEC antes de usarlo en los análisis del Dataton."/>
    <taggedValue xmi:id="_5eHFM9oLEfGjVb1XdXSgUA" tag="Description" value="Análisis de profiling de la columna(s) del archivo Clasificador_Geografico_2022 (provincia, cantón, parroquia y sus códigos). Se calculan indicadores de calidad: conteo de filas, nulos, valores distintos, duplicados, longitud mínima/máxima y tabla de frecuencias. El objetivo es detectar códigos faltantes, duplicados o con formato inconsistente, y confirmar que el clasificador sirve como llave de unión por cantón y provincia con las demás fuentes del lago de datos."/>
    <taggedValue xmi:id="_5eHFNNoLEfGjVb1XdXSgUA" tag="Version" value="0.1"/>
    <taggedValue xmi:id="_U7njMdoMEfGjVb1XdXSgUA" tag="ANA_LAST_RUN_CONTEXT" value="Default"/>
    <taggedValue xmi:id="_U7njMtoMEfGjVb1XdXSgUA" tag="PREVIEW_ROW_NUMBER" value="50"/>
    <taggedValue xmi:id="_U7oKQNoMEfGjVb1XdXSgUA" tag="NUMBER_OF_CONNECTIONS_PER_ANALYSIS" value="5"/>
    <taggedValue xmi:id="_U7oxUNoMEfGjVb1XdXSgUA" tag="Is Use Sample Data" value="false"/>
