      <indicators xsi:type="dataquality.indicators:BlankCountIndicator" xmi:id="_1a4Q_NoCEfG1mLTNfSJ-KA" count="205346" computed="true" blankCount="106660">
        <parameters xmi:id="_1a4Q_doCEfG1mLTNfSJ-KA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/BDDenemdu_personas_2022_anual_0.1.item#_xe92_NijEfGlBbYMxLBL7w"/>
