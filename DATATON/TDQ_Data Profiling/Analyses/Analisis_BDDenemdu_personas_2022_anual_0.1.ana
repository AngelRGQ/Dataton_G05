      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_1a43KNoCEfG1mLTNfSJ-KA" count="205346" computed="true" distinctValueCount="161">
        <parameters xmi:id="_1a43KdoCEfG1mLTNfSJ-KA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/BDDenemdu_personas_2022_anual_0.1.item#_xe93FtijEfGlBbYMxLBL7w"/>
