      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_1a1zddoCEfG1mLTNfSJ-KA" count="205346" computed="true">
        <parameters xmi:id="_1a1zdtoCEfG1mLTNfSJ-KA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/BDDenemdu_personas_2022_anual_0.1.item#_xe9P9NijEfGlBbYMxLBL7w"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Null_Count_0.1.definition#_GrAeADh9Ed2XmO7pl5Yuyg"/>
        <builtInIndicatorDefinition xmi:id="_2PimgNoCEfG1mLTNfSJ-KA" name="Null Count" label="Null Count">
