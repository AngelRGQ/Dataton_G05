        <builtInIndicatorDefinition xmi:id="_119B0NoCEfG1mLTNfSJ-KA" name="Row Count" label="Row Count">
          <taggedValue xmi:id="_119B0doCEfG1mLTNfSJ-KA" tag="Description" value="counts the number of rows"/>
          <taggedValue xmi:id="_119B0toCEfG1mLTNfSJ-KA" tag="Purpose" value="evaluates the number of records"/>
