          <taggedValue xmi:id="_29obktoCEfG1mLTNfSJ-KA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_29obk9oCEfG1mLTNfSJ-KA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_1a4PetoCEfG1mLTNfSJ-KA" count="205346" computed="true">
