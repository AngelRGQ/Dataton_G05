      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_1a3pINoCEfG1mLTNfSJ-KA" count="205346" computed="true" distinctValueCount="85">
        <parameters xmi:id="_1a3pIdoCEfG1mLTNfSJ-KA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/BDDenemdu_personas_2022_anual_0.1.item#_xe9QD9ijEfGlBbYMxLBL7w"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Distinct_Count_0.1.definition#_ccHq0BF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_259cgNoCEfG1mLTNfSJ-KA" name="Distinct Count" label="Distinct Count">
          <taggedValue xmi:id="_259cgdoCEfG1mLTNfSJ-KA" tag="Description" value="counts the number of distinct rows (like a &quot;SELECT DISTINCT&quot; SQL statement)"/>
          <taggedValue xmi:id="_259cgtoCEfG1mLTNfSJ-KA" tag="Purpose" value="evaluates the number of distinct records"/>
          <sqlGenericExpression xmi:id="_259cg9oCEfG1mLTNfSJ-KA" body="SELECT COUNT(*) FROM (SELECT DISTINCT &lt;%=__COLUMN_NAMES__%> FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>) A" language="SQL"/>
