          <taggedValue xmi:id="_2A1cItoCEfG1mLTNfSJ-KA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_2A1cI9oCEfG1mLTNfSJ-KA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
