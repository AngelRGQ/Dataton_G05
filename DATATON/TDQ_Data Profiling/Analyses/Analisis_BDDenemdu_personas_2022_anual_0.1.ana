          <taggedValue xmi:id="_4IyAEtoCEfG1mLTNfSJ-KA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_4IyAE9oCEfG1mLTNfSJ-KA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
