          <taggedValue xmi:id="_3JRq4doCEfG1mLTNfSJ-KA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_3JRq4toCEfG1mLTNfSJ-KA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_3JRq49oCEfG1mLTNfSJ-KA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
