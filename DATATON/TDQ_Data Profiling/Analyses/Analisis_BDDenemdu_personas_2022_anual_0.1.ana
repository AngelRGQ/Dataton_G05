      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_1a42ztoCEfG1mLTNfSJ-KA" count="205346" computed="true" distinctValueCount="332">
        <parameters xmi:id="_1a42z9oCEfG1mLTNfSJ-KA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/BDDenemdu_personas_2022_anual_0.1.item#_xe93EdijEfGlBbYMxLBL7w"/>
