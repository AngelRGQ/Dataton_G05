        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Row_Count_0.1.definition#_ccFOkBF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_wK0HINoGEfGjVb1XdXSgUA" name="Row Count" label="Row Count">
          <taggedValue xmi:id="_wK0HIdoGEfGjVb1XdXSgUA" tag="Description" value="counts the number of rows"/>
          <taggedValue xmi:id="_wK0HItoGEfGjVb1XdXSgUA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_wK0HI9oGEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_v6TmBtoGEfGjVb1XdXSgUA" count="3040" computed="true">
        <parameters xmi:id="_v6TmB9oGEfGjVb1XdXSgUA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/INEC_NBI_10_2_pobreza_por_parroquia_0.1.item#_Rd559di-EfGS4Oy_nGQk2w"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Null_Count_0.1.definition#_GrAeADh9Ed2XmO7pl5Yuyg"/>
        <builtInIndicatorDefinition xmi:id="_wK-fMNoGEfGjVb1XdXSgUA" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_wK-fMdoGEfGjVb1XdXSgUA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_wK-fMtoGEfGjVb1XdXSgUA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_wK-fM9oGEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_v6TmCNoGEfGjVb1XdXSgUA" count="3040" computed="true" distinctValueCount="1163">
        <parameters xmi:id="_v6TmCdoGEfGjVb1XdXSgUA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/INEC_NBI_10_2_pobreza_por_parroquia_0.1.item#_Rd559di-EfGS4Oy_nGQk2w"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Distinct_Count_0.1.definition#_ccHq0BF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_wLKFYNoGEfGjVb1XdXSgUA" name="Distinct Count" label="Distinct Count">
          <taggedValue xmi:id="_wLKFYdoGEfGjVb1XdXSgUA" tag="Description" value="counts the number of distinct rows (like a &quot;SELECT DISTINCT&quot; SQL statement)"/>
          <taggedValue xmi:id="_wLKFYtoGEfGjVb1XdXSgUA" tag="Purpose" value="evaluates the number of distinct records"/>
          <sqlGenericExpression xmi:id="_wLKFY9oGEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM (SELECT DISTINCT &lt;%=__COLUMN_NAMES__%> FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>) A" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:UniqueCountIndicator" xmi:id="_v6TmCtoGEfGjVb1XdXSgUA" count="3040" computed="true" uniqueValueCount="0">
        <parameters xmi:id="_v6TmC9oGEfGjVb1XdXSgUA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/INEC_NBI_10_2_pobreza_por_parroquia_0.1.item#_Rd559di-EfGS4Oy_nGQk2w"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Unique_Count_0.1.definition#_ccHq0RF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_wLT2YNoGEfGjVb1XdXSgUA" name="Unique Count" label="Unique Count">
          <taggedValue xmi:id="_wLT2YdoGEfGjVb1XdXSgUA" tag="Description" value="counts the number of unique rows (i.e. distinct rows with only one instance: rows that are not duplicated)"/>
          <taggedValue xmi:id="_wLT2YtoGEfGjVb1XdXSgUA" tag="Purpose" value="evaluates the number of unique records"/>
          <sqlGenericExpression xmi:id="_wLT2Y9oGEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM (SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__COLUMN_NAMES__%> HAVING COUNT(*) = 1) AS myquery" language="SQL"/>
          <sqlGenericExpression xmi:id="_wLT2ZNoGEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM (SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) mycount FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__COLUMN_NAMES__%> HAVING mycount = 1) AS myquery" language="MySQL"/>
          <sqlGenericExpression xmi:id="_wLT2ZdoGEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM (SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__COLUMN_NAMES__%> HAVING COUNT(*) = 1) myquery" language="Oracle"/>
          <sqlGenericExpression xmi:id="_wLT2ZtoGEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM (SELECT &lt;%=__COLUMN_NAMES__%>, COUNT(*) mycount FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%> GROUP BY &lt;%=__COLUMN_NAMES__%> HAVING mycount = 1) AS myquery" language="Teradata"/>
