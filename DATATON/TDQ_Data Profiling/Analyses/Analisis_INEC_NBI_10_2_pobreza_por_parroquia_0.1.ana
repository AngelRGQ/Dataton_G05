    <taggedValue xmi:id="_HcZzwtoGEfGjVb1XdXSgUA" tag="Purpose" value="Perfilar la calidad de la tabla de pobreza por NBI por parroquia del INEC, usada como referencia oficial para comparar el KPI de pobreza multidimensional."/>
    <taggedValue xmi:id="_HcZzw9oGEfGjVb1XdXSgUA" tag="Description" value="Análisis de la tabla INEC_NBI_10.1_pobreza_por_parroquia (fuente: INEC / datos.gob.ec, año 2022, registros, cargada en SingleStore, esquema raw).&#xD;&#xA;&#xD;&#xA;Objetivo: conocer el estado de los datos antes de usarlos como línea base en la comparación del KPI estrella (% de hogares en pobreza multidimensional por parroquia contra el NBI oficial).&#xD;&#xA;&#xD;&#xA;Qué se revisa:&#xD;&#xA;- Completitud: cantidad de nulos y vacíos en el código de cantón y en el indicador de pobreza por NBI.&#xD;&#xA;- Unicidad: un solo registro por cantón (sin duplicados en el código de cantón).&#xD;&#xA;- Formato: el código de cantón debe seguir el patrón de 4 dígitos del clasificador DPA.&#xD;&#xA;- Rango: el porcentaje de pobreza debe estar entre 0 y 100.&#xD;&#xA;- Cobertura: cantidad de cantones presentes frente a los 221 del clasificador.&#xD;&#xA;"/>
    <taggedValue xmi:id="_Hcaa0NoGEfGjVb1XdXSgUA" tag="Version" value="0.1"/>
    <taggedValue xmi:id="_mtG2kdoGEfGjVb1XdXSgUA" tag="ANA_LAST_RUN_CONTEXT" value="Default"/>
    <taggedValue xmi:id="_mtG2ktoGEfGjVb1XdXSgUA" tag="PREVIEW_ROW_NUMBER" value="50"/>
    <taggedValue xmi:id="_mtG2k9oGEfGjVb1XdXSgUA" tag="NUMBER_OF_CONNECTIONS_PER_ANALYSIS" value="5"/>
    <taggedValue xmi:id="_mtIEsNoGEfGjVb1XdXSgUA" tag="Is Use Sample Data" value="false"/>
