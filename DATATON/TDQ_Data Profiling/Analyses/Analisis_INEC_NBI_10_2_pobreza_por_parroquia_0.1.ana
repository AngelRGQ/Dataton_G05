  <dataquality.analysis:Analysis xmi:id="_HcZMsNoGEfGjVb1XdXSgUA" name="Analisis_INEC_NBI_10.2_pobreza_por_parroquia" supplierDependency="_TAXrkNyKEfGlKqMMAiYwrQ" creationDate="2026-11-06T12:18:42.899-0500" defaultContext="Default">
    <clientDependency href="../../metadata/fileDelimited/lago_de_datos_grupo5/INEC_NBI_10_2_pobreza_por_parroquia_0.1.item#_v6S-6doGEfGjVb1XdXSgUA"/>
