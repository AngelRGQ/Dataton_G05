      <indicators xsi:type="dataquality.indicators:BlankCountIndicator" xmi:id="_2a63eNn_EfGo9sFIfF8LhA" count="738" computed="true">
        <parameters xmi:id="_2a63edn_EfGo9sFIfF8LhA"/>
