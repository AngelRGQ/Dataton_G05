      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_2a63hNn_EfGo9sFIfF8LhA" count="738" computed="true">
        <parameters xmi:id="_2a63hdn_EfGo9sFIfF8LhA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/INEC_NBI_9_1_Pobreza_extrema_por_NBI_0.1.item#_03-JZNi_EfGS4Oy_nGQk2w"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Null_Count_0.1.definition#_GrAeADh9Ed2XmO7pl5Yuyg"/>
        <builtInIndicatorDefinition xmi:id="_2sM0sNn_EfGo9sFIfF8LhA" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_2sM0sdn_EfGo9sFIfF8LhA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_2sM0stn_EfGo9sFIfF8LhA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_2sM0s9n_EfGo9sFIfF8LhA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
