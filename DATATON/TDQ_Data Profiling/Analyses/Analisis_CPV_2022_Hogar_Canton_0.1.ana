          <sqlGenericExpression xmi:id="_L9ZAw9oIEfG1mLTNfSJ-KA" body="SELECT COUNT(*) FROM (SELECT DISTINCT &lt;%=__COLUMN_NAMES__%> FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>) A" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:UniqueCountIndicator" xmi:id="_LXVu_toIEfG1mLTNfSJ-KA" count="5193548" nullCount="4721" computed="true" uniqueValueCount="0">
