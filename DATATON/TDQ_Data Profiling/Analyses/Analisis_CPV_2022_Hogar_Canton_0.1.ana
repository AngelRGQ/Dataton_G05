      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_LXVtkNoIEfG1mLTNfSJ-KA" count="5193548" computed="true" distinctValueCount="1042040">
        <parameters xmi:id="_LXVtkdoIEfG1mLTNfSJ-KA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/CPV_2022_Hogar_Canton_0.1.item#_z9flU9iXEfGlBbYMxLBL7w"/>
