      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_LXVvfdoIEfG1mLTNfSJ-KA" count="5193548" computed="true" distinctValueCount="5193548">
        <parameters xmi:id="_LXVvftoIEfG1mLTNfSJ-KA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/CPV_2022_Hogar_Canton_0.1.item#_z9fletiXEfGlBbYMxLBL7w"/>
