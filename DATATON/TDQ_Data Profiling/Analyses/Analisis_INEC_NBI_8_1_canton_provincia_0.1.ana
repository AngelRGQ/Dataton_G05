        <builtInIndicatorDefinition xmi:id="_HXtPENoIEfGjVb1XdXSgUA" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_HXtPEdoIEfGjVb1XdXSgUA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_HXtPEtoIEfGjVb1XdXSgUA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_HXtPE9oIEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
