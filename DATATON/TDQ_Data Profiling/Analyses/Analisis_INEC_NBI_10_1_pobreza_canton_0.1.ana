          <taggedValue xmi:id="_hn1NktoAEfGjVb1XdXSgUA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_hn1Nk9oAEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
