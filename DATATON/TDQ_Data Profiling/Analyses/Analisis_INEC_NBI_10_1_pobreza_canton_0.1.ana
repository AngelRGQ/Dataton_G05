  <dataquality.analysis:Analysis xmi:id="_Oz-g4NmbEfGGcpTvbYcMxw" name="Analisis_INEC_NBI_10_1_pobreza_canton" supplierDependency="_DLLBYNoBEfGjVb1XdXSgUA" creationDate="2026-11-05T23:33:35.318-0500" defaultContext="Default">
    <clientDependency href="../../metadata/fileDelimited/lago_de_datos_grupo5/INEC_NBI_10_1_pobreza_por_cantón_0.1.item#_K4dRENmcEfGGcpTvbYcMxw"/>
    <taggedValue xmi:id="_Oz_H8NmbEfGGcpTvbYcMxw" tag="Status" value="Draft"/>
