      <indicators xsi:type="dataquality.indicators:RowCountIndicator" xmi:id="_K4d4M9mcEfGGcpTvbYcMxw" count="738" computed="true">
        <parameters xmi:id="_K4d4NNmcEfGGcpTvbYcMxw"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../metadata/fileDelimited/lago_de_datos_grupo5/INEC_NBI_10_1_pobreza_por_cantón_0.1.item#_S0u_dNi9EfGS4Oy_nGQk2w"/>
        <indicatorDefinition href="../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Row_Count_0.1.definition#_ccFOkBF2Ed2PKb6nEJEvhw"/>
        <builtInIndicatorDefinition xmi:id="_hjNzUNoAEfGjVb1XdXSgUA" name="Row Count" label="Row Count">
          <taggedValue xmi:id="_hjNzUdoAEfGjVb1XdXSgUA" tag="Description" value="counts the number of rows"/>
          <taggedValue xmi:id="_hjNzUtoAEfGjVb1XdXSgUA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_hjNzU9oAEfGjVb1XdXSgUA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
      </indicators>
      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_K4d4NdmcEfGGcpTvbYcMxw" count="738" computed="true">
