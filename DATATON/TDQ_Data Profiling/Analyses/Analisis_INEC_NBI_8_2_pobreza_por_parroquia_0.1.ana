        <builtInIndicatorDefinition xmi:id="_id49wNn-EfGo9sFIfF8LhA" name="Distinct Count" label="Distinct Count">
          <taggedValue xmi:id="_id49wdn-EfGo9sFIfF8LhA" tag="Description" value="counts the number of distinct rows (like a &quot;SELECT DISTINCT&quot; SQL statement)"/>
          <taggedValue xmi:id="_id49wtn-EfGo9sFIfF8LhA" tag="Purpose" value="evaluates the number of distinct records"/>
          <sqlGenericExpression xmi:id="_id49w9n-EfGo9sFIfF8LhA" body="SELECT COUNT(*) FROM (SELECT DISTINCT &lt;%=__COLUMN_NAMES__%> FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>) A" language="SQL"/>
