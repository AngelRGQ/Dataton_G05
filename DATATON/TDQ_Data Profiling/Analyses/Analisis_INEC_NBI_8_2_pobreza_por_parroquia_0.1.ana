          <taggedValue xmi:id="_idZOgtn-EfGo9sFIfF8LhA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_idZOg9n-EfGo9sFIfF8LhA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
